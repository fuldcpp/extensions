  "description": "Finds better copies (higher resolution, or a PROPER/REPACK of the same release) of the films and episodes you already have. Reports only, unless you turn on automatic replacing.",
  "license": "MIT",
  "author": {
    "name": "FulDC++"
  },
  "keywords": [
    "airdcpp",
    "airdcpp-extensions",
    "airdcpp-extensions-public",
    "upgrade",
    "quality",
    "proper",
    "repack",
    "movies",
    "tv"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fuldcpp/extensions/"
  },
  "bugs": "https://github.com/fuldcpp/extensions/issues/",
  "scripts": {
    "build": "webpack --mode production",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "airdcpp-extension": "1.5.1",
    "airdcpp-extension-settings": "1.2.2",
    "source-map-support": "^0.5.21",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "main": "dist/main.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "airdcpp": {
    "apiVersion": 1,
    "minApiFeatureLevel": 0
  }
