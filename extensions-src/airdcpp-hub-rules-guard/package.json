{
  "name": "airdcpp-hub-rules-guard",
  "version": "1.0.0-beta.1",
  "description": "Learns each hub's rules (minimum share, slots, hub count, slot ratio) and warns you in the hub window before the hub kicks you",
  "license": "MIT",
  "author": {
    "name": "FulDC++"
  },
  "keywords": [
    "airdcpp",
    "airdcpp-extensions",
    "airdcpp-extensions-public",
    "hub",
    "rules",
    "minimum share",
    "slots"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fuldcpp/extensions/"
  },
  "bugs": "https://github.com/fuldcpp/extensions/issues/",
  "scripts": {
    "build": "webpack --mode production",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "airdcpp-extension": "1.5.1",
    "airdcpp-extension-settings": "1.2.2",
    "source-map-support": "^0.5.21",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "main": "dist/main.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "airdcpp": {
    "apiVersion": 1,
    "minApiFeatureLevel": 0
  }
}
