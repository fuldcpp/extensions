+import { tmpDir, write } from './helpers';
+
+const logger = { verbose: () => undefined, error: () => undefined };
+
+test('accepting a release covers its subfolders', async () => {
+  const dir = tmpDir();
+  const store = AcceptedReleases(path.join(dir, 'accepted.json'), logger);
+  await store.accept(path.join(dir, 'Some.Release-GRP'));
+  expect(store.isAccepted(path.join(dir, 'Some.Release-GRP', 'CD1'))).toBe(true);
+  expect(store.isAccepted(path.join(dir, 'Some.Release-GRP', 'CD1', 'a.rar'))).toBe(true);
+  expect(store.isAccepted(path.join(dir, 'Some.Release-GRP2'))).toBe(false);
+});
+
+test('start-up cleanup keeps entries on a drive that is not reachable, drops ones really gone', async () => {
+  const dir = tmpDir();
+  const file = path.join(dir, 'accepted.json');
+  const present = path.join(dir, 'Present-GRP');
+  fs.mkdirSync(present);
+  const gone = path.join(dir, 'Gone-GRP');
+  const unreachable = path.join(dir, 'not-mounted', 'share', 'Rel-GRP');
+  write(file, JSON.stringify([present, gone, unreachable]));
+  const store = AcceptedReleases(file, logger);
+  await store.load();
+  expect(await store.prune()).toBe(1);
+  expect(store.isAccepted(present)).toBe(true);
+  expect(store.isAccepted(unreachable)).toBe(true);
+  expect(store.isAccepted(gone)).toBe(false);
+});
+
+test('saving is atomic and a failed save is reported to the caller', async () => {
+  const dir = tmpDir();
+  const file = path.join(dir, 'accepted.json');
+  const store = AcceptedReleases(file, logger);
+  await store.accept(path.join(dir, 'A-GRP'));
+  expect(JSON.parse(fs.readFileSync(file, 'utf8'))).toEqual([path.join(dir, 'A-GRP')]);
+  expect(fs.existsSync(file + '.tmp')).toBe(false);
+
+  const blocked = AcceptedReleases(path.join(dir, 'no-such-folder', 'accepted.json'), logger);
+  await expect(blocked.accept(path.join(dir, 'B-GRP'))).rejects.toBeTruthy();
+});
+
+test('a corrupt list is kept aside instead of being overwritten', async () => {
+  const dir = tmpDir();
+  const file = write(path.join(dir, 'accepted.json'), '{ broken');
+  const store = AcceptedReleases(file, logger);
+  await store.load();
+  expect(fs.readdirSync(dir).some(name => name.startsWith('accepted.json.corrupt-'))).toBe(true);
+});
