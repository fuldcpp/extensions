+  const reject = jest.fn();
+  await ScanRunners(context([throwing])).onBundleFinished({ type: { id: 'directory' }, target: dir, name: 'x' } as any, accept, reject);
+  expect(accept).toHaveBeenCalledTimes(1);
+  expect(reject).not.toHaveBeenCalled();
+});
+
+test('a throwing new-share-directory scan answers at once too', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  const accept = jest.fn();
+  const handler = ScanRunners(context([throwing])).getShareDirectoryAddedHandler(false);
