+// name must contain a dot or an underscore so plain "holiday-photos" folders stay out
+const lowerCaseReleaseReg = /^[a-z0-9]\S*[._]\S*-[A-Za-z0-9_]{2,}$/;
+
+const isRedownloadableReleaseName = (name: string) => isReleaseName(name) || lowerCaseReleaseReg.test(name);
+
+// Resolved first, separator stripped only when the path is not a root ("D:\" must not become
+// "D:", which means the current folder of drive D)
+const resolveFolder = (dirPath: string) => {
+  const resolved = path.resolve(dirPath);
+  return path.parse(resolved).root === resolved ? resolved : resolved.replace(/[\\/]+$/, '');
+};
+
+// The release folder a path belongs to, or null when it is not inside one. A disc/Sample/Subs
+// folder resolves to its parent release; anything whose name is not a release name (a share root,
+// a personal folder) gives null. Used before any automatic search: a hub search for "CD1",
+// "Sample" or a share root's name would match unrelated folders of other users.
+export const releaseFolderOf = (dirPath: string): string | null => {
+  let current = resolveFolder(dirPath);
+  for (let depth = 0; depth < 3 && isReleaseSubfolder(path.basename(current)); depth++) {
+    const parent = path.dirname(current);
+    if (parent === current) {
+      return null;
+    }
+
+    current = parent;
+  }
+
+  return isRedownloadableReleaseName(path.basename(current)) ? current : null;
+};
+
 // Shared "release names allowed to have no SFV/NFO" exemption list (the
 // "no_sfv_exempt_patterns" setting) -- originally only wired into
 // IncompleteRelease, moved here so MissingSfv/MissingNfo respect it too. A
