+import fs from 'node:fs';
+import path from 'node:path';
+
+import Scanner from '../src/Scanner';
+import SFVChecker from '../src/validators/SFVChecker';
+import MissingNfo from '../src/validators/MissingNfo';
+import { releaseFolderOf } from '../src/validators/common';
+import { tmpDir, write } from './helpers';
+
+const quietLogger: any = () => undefined;
+
+const scan = async (dir: string, validators: any[]) => {
+  const scanner = Scanner(validators, quietLogger, () => true);
+  await scanner.scanPath(dir);
+  return scanner.errors.getErrors();
+};
+
+test('Thumbs.db / desktop.ini are not extra files of a release', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  write(path.join(dir, 'release.sfv'), 'a.rar 1234ABCD\n');
+  write(path.join(dir, 'Thumbs.db'));
+  write(path.join(dir, 'desktop.ini'));
+  expect(Object.keys(await scan(dir, [SFVChecker]))).toEqual([]);
+});
+
+test('files set aside by this extension are not reported as extra files', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  write(path.join(dir, 'a.r00.crcfail'));
+  write(path.join(dir, 'old.sfv.bad'));
+  write(path.join(dir, 'release.sfv'), 'a.rar 1234ABCD\n');
+  expect(Object.keys(await scan(dir, [SFVChecker]))).toEqual([]);
+});
+
+test('a .dctmp partial file is never deleted, however old', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  write(path.join(dir, 'release.sfv'), 'a.rar 1234ABCD\nb.rar 1234ABCD\n');
+  const partial = write(path.join(dir, 'b.rar.dctmp'), 'progress');
+  const old = new Date(Date.now() - 24 * 3600 * 1000);
+  fs.utimesSync(partial, old, old);
+  await scan(dir, [SFVChecker]);
+  expect(fs.readFileSync(partial, 'utf8')).toBe('progress');
+});
+
+test('a junction inside a release is not followed', async () => {
+  const root = tmpDir();
+  const outside = path.join(root, 'outside');
+  write(path.join(outside, 'secret.txt'));
+  const dir = path.join(root, 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  try {
+    fs.symlinkSync(outside, path.join(dir, 'link'), 'junction');
+  } catch (e) {
+    return; // links not available on this machine
+  }
+
+  const scanner = Scanner([], quietLogger, () => true);
+  await scanner.scanPath(dir);
+  expect(scanner.stats.scannedDirectories).toBe(1);
+});
+
+test('CD01..CD99 are disc folders (the NFO is looked for inside them)', async () => {
+  const dir = path.join(tmpDir(), 'Some.Album-GRP');
+  write(path.join(dir, 'CD01', 'album.nfo'));
+  write(path.join(dir, 'CD02', 'a.flac'));
+  expect(Object.keys(await scan(dir, [MissingNfo]))).not.toContain('nfo_missing');
+});
+
+test('releaseFolderOf: release, its subfolders, and non-releases', () => {
+  const root = tmpDir();
+  expect(releaseFolderOf(path.join(root, 'Some.Album-GRP'))).toBe(path.join(root, 'Some.Album-GRP'));
+  expect(releaseFolderOf(path.join(root, 'Some.Album-GRP', 'CD1'))).toBe(path.join(root, 'Some.Album-GRP'));
+  expect(releaseFolderOf(path.join(root, 'Some.Movie-GRP', 'Sample') + path.sep)).toBe(path.join(root, 'Some.Movie-GRP'));
+  expect(releaseFolderOf(path.join(root, 'Holiday 2019'))).toBeNull();
+  expect(releaseFolderOf(path.join(root, 'Music', 'CD1'))).toBeNull();
+});
diff --git a/tests/sfv.test.ts b/tests/sfv.test.ts
new file mode 100644
index 0000000..b3d05a1
--- /dev/null
+++ b/tests/sfv.test.ts
@@ -0,0 +1,48 @@
+import path from 'node:path';
+
+import SFVReader from '../src/helpers/SFVReader';
+import { tmpDir, write } from './helpers';
+
+// Loads an SFV file with these bytes the way the validators do and returns what it read
+const load = async (bytes: Buffer | string) => {
+  const dir = tmpDir();
+  write(path.join(dir, 'release.sfv'), bytes);
+  const reader = SFVReader(dir);
+  await reader.load('release.sfv');
+  return reader.content;
+};
+
+test('a UTF-8 BOM does not become part of the first name', async () => {
+  const bytes = Buffer.concat([Buffer.from([0xef, 0xbb, 0xbf]), Buffer.from('first.rar 1234ABCD\n')]);
+  expect(await load(bytes)).toEqual({ 'first.rar': '1234ABCD' });
+});
+
+test('UTF-16 SFVs (as the client reads them) are parsed', async () => {
+  const bytes = Buffer.concat([Buffer.from([0xff, 0xfe]), Buffer.from('a.rar 0000ffff\r\n', 'utf16le')]);
+  expect(await load(bytes)).toEqual({ 'a.rar': '0000ffff' });
+});
+
+test('ANSI (cp1252) names are not turned into replacement characters', async () => {
+  const bytes = Buffer.from([0x63, 0x61, 0x66, 0xe9, 0x2e, 0x6d, 0x70, 0x33, 0x20, 0x31, 0x32, 0x33, 0x34, 0x41, 0x42, 0x43, 0x44]);
+  expect(await load(bytes)).toEqual({ 'café.mp3': '1234ABCD' });
+});
+
+test('only lines starting with ";" are comments; ";" inside a name is fine', async () => {
+  expect(await load('; generated by tool\nlive;edit.mp3 1234ABCD\n')).toEqual({ 'live;edit.mp3': '1234ABCD' });
+});
+
+test('trailing whitespace, quotes and spaces in names', async () => {
+  expect(await load('"my file.rar" 1234abcd   \n')).toEqual({ 'my file.rar': '1234abcd' });
+});
+
+test('a CRC must be hexadecimal', async () => {
+  await expect(load('a.rar NOTAHEX1\n')).rejects.toThrow(/No valid lines/);
+});
+
+test('an SFV of only subfolder lines is valid (nothing of this folder to check)', async () => {
+  expect(await load('CD1\\a.rar 1234ABCD\nCD2/b.rar 1234ABCD\n')).toEqual({});
+});
+
+test('an SFV with no valid lines is rejected with its own error code', async () => {
+  await expect(load('nothing useful\n')).rejects.toMatchObject({ code: 'SFV_NO_VALID_LINES' });
+});
