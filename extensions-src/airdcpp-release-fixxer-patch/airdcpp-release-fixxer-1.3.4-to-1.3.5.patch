+import fs from 'node:fs';
+import path from 'node:path';
+
+import CrcRedownload, { pickBestResult } from '../src/CrcRedownload';
+import { fakeSocket, settings, settle, tmpDir, write } from './helpers';
+
+const noSleep = { sleep: async () => undefined };
+
+describe('which search result is downloaded', () => {
+  test('only an exact (case-insensitive) name match, never "the first result"', () => {
+    const results = [{ id: 'a', name: 'Some.Release.PROPER-GRP' }, { id: 'b', name: 'some.release-grp' }];
+    expect(pickBestResult(results, 'Some.Release-GRP')).toEqual({ id: 'b', name: 'some.release-grp' });
+    expect(pickBestResult([{ id: 'a', name: 'Other.Release-XYZ' }], 'Some.Release-GRP')).toBeUndefined();
+  });
+
+  test('no exact match: nothing is downloaded into the folder', async () => {
+    const root = tmpDir();
+    const release = path.join(root, 'Some.Release-GRP');
+    write(path.join(release, 'a.rar'));
+    const fake = fakeSocket(() => [{ id: 'r1', name: 'Unrelated.Folder-ABC' }]);
+    const crc = CrcRedownload(fake.socket, settings(), noSleep);
+    await crc.onFileMissing(release, 'file_missing');
+    await settle();
+    expect(fake.searches).toEqual(['Some.Release-GRP']);
+    expect(fake.downloads).toEqual([]);
+  });
+});
+
+describe('what may start a download', () => {
+  test('"possibly missing" heuristics never search', async () => {
+    const root = tmpDir();
+    const release = path.join(root, 'Some.Release-GRP');
+    write(path.join(release, 'a.mp3'));
+    const fake = fakeSocket(() => [{ id: 'r1', name: 'Some.Release-GRP' }]);
+    const crc = CrcRedownload(fake.socket, settings(), noSleep);
+    for (const id of ['sfv_missing', 'nfo_missing', 'incomplete_no_sfv', 'no_release_files']) {
+      await crc.onFileMissing(release, id);
+    }
+
+    await settle();
+    expect(fake.searches).toEqual([]);
+  });
+
+  test('a personal folder or a share root is never searched for by name', async () => {
+    const root = tmpDir();
+    const personal = path.join(root, 'Holiday 2019');
+    write(path.join(personal, 'track.mp3'));
+    const fake = fakeSocket(() => [{ id: 'r1', name: 'Holiday 2019' }]);
+    const crc = CrcRedownload(fake.socket, settings(), noSleep);
+    await crc.onFileMissing(personal, 'file_missing');
+    await crc.onFileMissing(root, 'file_missing');
+    await settle();
+    expect(fake.searches).toEqual([]);
+  });
+
+  test('a disc/Sample/Subs folder resolves to its release: the release is searched, not "CD1"', async () => {
+    const root = tmpDir();
+    const release = path.join(root, 'Some.Album-GRP');
+    write(path.join(release, 'CD1', 'a.flac'));
+    const fake = fakeSocket(() => [{ id: 'r1', name: 'Some.Album-GRP' }]);
+    const crc = CrcRedownload(fake.socket, settings(), noSleep);
+    await crc.onFileMissing(path.join(release, 'CD1'), 'file_missing');
+    await settle();
+    expect(fake.searches).toEqual(['Some.Album-GRP']);
+    expect(fake.downloads[0].body).toEqual({ target_name: 'Some.Album-GRP', target_directory: root + path.sep });
+  });
+
+  test('accepted releases are left alone', async () => {
+    const root = tmpDir();
+    const release = path.join(root, 'Some.Release-GRP');
+    write(path.join(release, 'a.rar'));
+    const fake = fakeSocket(() => [{ id: 'r1', name: 'Some.Release-GRP' }]);
+    const crc = CrcRedownload(fake.socket, settings({ isAccepted: (p: string) => p.startsWith(release) }), noSleep);
+    await crc.onFileMissing(release, 'file_missing');
+    await settle();
+    expect(fake.searches).toEqual([]);
+  });
+});
+
+describe('nothing is deleted', () => {
+  test('a CRC failure renames the file to .crcfail and starts a redownload of the release', async () => {
+    const root = tmpDir();
+    const release = path.join(root, 'Some.Release-GRP');
+    const file = write(path.join(release, 'a.r00'), 'data');
+    const fake = fakeSocket(() => [{ id: 'r1', name: 'Some.Release-GRP' }]);
+    const crc = CrcRedownload(fake.socket, settings(), noSleep);
+    crc.start();
+    await fake.hasherFileFailed({ error_id: 'crc_error', path: file });
+    expect(fs.existsSync(file)).toBe(false);
+    expect(fs.readFileSync(file + '.crcfail', 'utf8')).toBe('data');
+    expect(fake.searches).toEqual(['Some.Release-GRP']);
+  });
+
+  test('a second failure of the same name gets .crcfail.2, the first copy is kept', async () => {
+    const root = tmpDir();
+    const file = write(path.join(root, 'Rel-GRP', 'a.r00'), 'one');
+    const fake = fakeSocket();
+    CrcRedownload(fake.socket, settings({ getRedownload: () => false }), noSleep).start();
+    await fake.hasherFileFailed({ error_id: 'crc_error', path: file });
+    write(file, 'two');
+    await fake.hasherFileFailed({ error_id: 'crc_error', path: file });
+    expect(fs.readFileSync(file + '.crcfail', 'utf8')).toBe('one');
+    expect(fs.readFileSync(file + '.crcfail.2', 'utf8')).toBe('two');
+  });
+
+  test('CRC failures in an accepted release are left untouched', async () => {
+    const root = tmpDir();
+    const file = write(path.join(root, 'Rel-GRP', 'a.mp3'), 'retagged');
+    const fake = fakeSocket();
+    CrcRedownload(fake.socket, settings({ isAccepted: () => true }), noSleep).start();
+    await fake.hasherFileFailed({ error_id: 'crc_error', path: file });
+    expect(fs.readFileSync(file, 'utf8')).toBe('retagged');
+  });
+
+  test('at most 20 files are set aside per hour', async () => {
+    const root = tmpDir();
+    const fake = fakeSocket();
+    CrcRedownload(fake.socket, settings({ getRedownload: () => false }), noSleep).start();
+    const files = Array.from({ length: 25 }, (_, i) => write(path.join(root, 'Rel-GRP', `f${i}.mp3`)));
+    for (const file of files) {
+      await fake.hasherFileFailed({ error_id: 'crc_error', path: file });
+    }
+
+    expect(files.filter(f => fs.existsSync(f + '.crcfail')).length).toBe(20);
+    expect(files.filter(f => fs.existsSync(f)).length).toBe(5);
+  }, 30000);
+
+  test('an invalid SFV is renamed to .sfv.bad only when it has no valid lines; valid SFVs stay', async () => {
+    const root = tmpDir();
+    const release = path.join(root, 'Some.Release-GRP');
+    write(path.join(release, 'broken.sfv'), 'garbage only\n');
+    write(path.join(release, 'good.sfv'), 'a.rar 1234ABCD\n');
+    const crc = CrcRedownload(fakeSocket().socket, settings(), noSleep);
+    await crc.onFileMissing(release, 'invalid_sfv_file');
+    await settle();
+    expect(fs.existsSync(path.join(release, 'broken.sfv'))).toBe(false);
+    expect(fs.existsSync(path.join(release, 'broken.sfv.bad'))).toBe(true);
+    expect(fs.existsSync(path.join(release, 'good.sfv'))).toBe(true);
+  });
+});
+
+describe('search budget and cancel', () => {
+  test('at most 30 searches per hour; the next waits for the budget', async () => {
+    const root = tmpDir();
+    let clock = 1_000_000;
+    const sleeps: number[] = [];
+    const fake = fakeSocket(() => []);
+    const crc = CrcRedownload(fake.socket, settings(), {
+      now: () => clock,
+      sleep: async (ms: number) => { sleeps.push(ms); clock += ms; },
+    });
+    for (let i = 0; i < 31; i++) {
+      const release = path.join(root, `Release.Number${i}-GRP`);
+      write(path.join(release, 'a.rar'));
+      crc.redownloadFolder(release);
+    }
+
+    await settle();
+    expect(fake.searches.length).toBe(31);
+    expect(Math.max(...sleeps)).toBeGreaterThan(59 * 60 * 1000);
+  });
+
+  test('accepting cancels a queued search', async () => {
+    const root = tmpDir();
+    const blocker = path.join(root, 'First.Release-GRP');
+    const target = path.join(root, 'Second.Release-GRP');
+    write(path.join(blocker, 'a.rar'));
+    write(path.join(target, 'a.rar'));
+    let release: () => void = () => undefined;
+    const fake = fakeSocket(() => []);
+    const crc = CrcRedownload(fake.socket, settings({ getSearchWaitSeconds: () => 1 }), {
+      sleep: () => new Promise<void>(resolve => { release = resolve; }),
+    });
+    crc.redownloadFolder(blocker);
+    crc.redownloadFolder(target);
+    await settle();
+    crc.cancel(target);
+    release();
+    await settle();
+    expect(fake.searches).toEqual(['First.Release-GRP']);
+  });
+});
