+// Tests for the findings of the independent review of the patch itself (second round)
+import fs from 'node:fs';
+import path from 'node:path';
+
+import Scanner from '../src/Scanner';
+import validators from '../src/validators';
+import CrcRedownload from '../src/CrcRedownload';
+import AcceptedReleases from '../src/AcceptedReleases';
+import ScanRunners from '../src/ScanRunners';
+import { releaseFolderOf } from '../src/validators/common';
+import SFVReader from '../src/helpers/SFVReader';
+import { fakeSocket, settings, settle, tmpDir, write } from './helpers';
+
+const noSleep = { sleep: async () => undefined };
+const quietLogger: any = () => undefined;
+
+test('a release missing both a file and its NFO is still repaired (proof wins over the order validators finish in)', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  write(path.join(dir, 'release.sfv'), 'a.rar 1234ABCD\nb.r00 1234ABCD\n');
+  const calls: Array<[string, string]> = [];
+  const scanner = Scanner(validators as any, quietLogger, () => true, () => false, (folder, id) => { calls.push([folder, id]); });
+  await scanner.scanPath(dir);
+  expect(Object.keys(scanner.errors.getErrors())).toEqual(expect.arrayContaining(['nfo_missing', 'file_missing']));
+  expect(calls.map(c => c[1])).toEqual(['file_missing']);
+});
+
+test('lower-case scene names are releases; plain dashed folder names are not', () => {
+  const root = tmpDir();
+  expect(releaseFolderOf(path.join(root, 'the.show.s01e01.720p.hdtv.x264-killers'))).toBe(path.join(root, 'the.show.s01e01.720p.hdtv.x264-killers'));
+  expect(releaseFolderOf(path.join(root, 'holiday-photos'))).toBeNull();
+  expect(releaseFolderOf(path.join(root, 'Some.Movie.DVDR-GRP', 'VIDEO_TS'))).toBe(path.join(root, 'Some.Movie.DVDR-GRP'));
+});
+
+test('a symlinked release file counts as present (no false "missing")', async () => {
+  const root = tmpDir();
+  const real = write(path.join(root, 'store', 'b.rar'));
+  const dir = path.join(root, 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  write(path.join(dir, 'release.sfv'), 'a.rar 1234ABCD\nb.rar 1234ABCD\n');
+  try {
+    fs.symlinkSync(real, path.join(dir, 'b.rar'), 'file');
+  } catch (e) {
+    return; // file symlinks need a privilege on Windows
+  }
+
+  const scanner = Scanner(validators as any, quietLogger, () => true);
+  await scanner.scanPath(dir);
+  expect(Object.keys(scanner.errors.getErrors())).not.toContain('file_missing');
+});
+
+test('a burst of CRC failures sets aside at most 20 (the slot is taken before any await)', async () => {
+  const root = tmpDir();
+  const fake = fakeSocket();
+  CrcRedownload(fake.socket, settings({ getRedownload: () => false }), noSleep).start();
+  const files = Array.from({ length: 30 }, (_, i) => write(path.join(root, 'Rel-GRP', `f${i}.mp3`)));
+  await Promise.all(files.map(file => fake.hasherFileFailed({ error_id: 'crc_error', path: file })));
+  await settle();
+  expect(files.filter(f => fs.existsSync(f)).length).toBe(10);
+}, 30000);
+
+test('with a quarantine folder, the failed file leaves the share (content kept, origin noted)', async () => {
+  const root = tmpDir();
+  const quarantine = path.join(root, 'quarantine');
+  const file = write(path.join(root, 'share', 'Some.Release-GRP', 'b.rar'), 'bad copy');
+  const fake = fakeSocket();
+  CrcRedownload(fake.socket, settings({ getRedownload: () => false, getQuarantineDir: () => quarantine }), noSleep).start();
+  await fake.hasherFileFailed({ error_id: 'crc_error', path: file });
+  expect(fs.existsSync(file)).toBe(false);
+  expect(fs.readdirSync(path.join(root, 'share', 'Some.Release-GRP'))).toEqual([]);
+  const [folder] = fs.readdirSync(quarantine);
+  expect(fs.readFileSync(path.join(quarantine, folder, 'b.rar.crcfail'), 'utf8')).toBe('bad copy');
+  expect(fs.readFileSync(path.join(quarantine, folder, 'origin.txt'), 'utf8').trim()).toBe(file);
+});
+
+test('quarantine copies older than 30 days are pruned; other folders are never touched', async () => {
+  const root = tmpDir();
+  const quarantine = path.join(root, 'quarantine');
+  const old = write(path.join(quarantine, '20200101T000000-1', 'origin.txt'), 'x');
+  const oldTime = new Date(Date.now() - 40 * 24 * 3600 * 1000);
+  fs.utimesSync(old, oldTime, oldTime);
+  write(path.join(quarantine, '20990101T000000-1', 'origin.txt'), 'x');
+  write(path.join(quarantine, 'my-own-folder', 'keep.txt'), 'x');
+  const crc = CrcRedownload(fakeSocket().socket, settings({ getQuarantineDir: () => quarantine }), noSleep);
+  expect(await crc.pruneQuarantine()).toBe(1);
+  expect(fs.readdirSync(quarantine).sort()).toEqual(['20990101T000000-1', 'my-own-folder']);
+});
+
+test('ANSI names are decoded as Windows-1252 (curly quote 0x92)', async () => {
+  const dir = tmpDir();
+  write(path.join(dir, 'r.sfv'), Buffer.concat([Buffer.from('it'), Buffer.from([0x92]), Buffer.from('s.mp3 1234ABCD\n')]));
+  const reader = SFVReader(dir);
+  await reader.load('r.sfv');
+  expect(reader.content).toEqual({ 'it’s.mp3': '1234ABCD' });
+});
+
+test('an unreadable or too large SFV does not start a redownload; the same broken SFV only once', async () => {
+  const root = tmpDir();
+  const big = path.join(root, 'Big.Release-GRP');
+  write(path.join(big, 'huge.sfv'), Buffer.alloc(1100 * 1024, 0x41));
+  const broken = path.join(root, 'Broken.Release-GRP');
+  const fake = fakeSocket(() => []);
+  const crc = CrcRedownload(fake.socket, settings(), noSleep);
+  await crc.onFileMissing(big, 'invalid_sfv_file');
+  await settle();
+  expect(fake.searches).toEqual([]);
+
+  write(path.join(broken, 'release.sfv'), 'garbage\n');
+  await crc.onFileMissing(broken, 'invalid_sfv_file');
+  await settle();
+  expect(fake.searches).toEqual(['Broken.Release-GRP']);
+
+  // Every source had the same broken SFV: downloaded again, it is not set aside and searched again
+  write(path.join(broken, 'release.sfv'), 'garbage\n');
+  (crc as any).cancel(broken);
+  await new Promise(resolve => setTimeout(resolve, 10));
+  await crc.onFileMissing(broken, 'invalid_sfv_file');
+  await settle();
+  expect(fake.searches).toEqual(['Broken.Release-GRP']);
+  expect(fs.existsSync(path.join(broken, 'release.sfv'))).toBe(true);
+});
+
+test('an accepted drive root covers what is below it', async () => {
+  const dir = tmpDir();
+  const store = AcceptedReleases(path.join(dir, 'accepted.json'), { verbose: () => undefined });
+  const root = path.parse(dir).root;
+  await store.accept(root);
+  expect(store.isAccepted(path.join(root, 'Some', 'Release-GRP'))).toBe(true);
+});
+
+test('a .dctmp partial file is not reported as an extra file', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  write(path.join(dir, 'a.nfo'));
+  write(path.join(dir, 'release.sfv'), 'a.rar 1234ABCD\n');
+  write(path.join(dir, 'b.rar.dctmp'));
+  const scanner = Scanner(validators as any, quietLogger, () => true);
+  await scanner.scanPath(dir);
+  expect(Object.keys(scanner.errors.getErrors())).not.toContain('extra_files');
+});
+
+test('a hook handler that rejects and then throws is answered once (the rejection stands)', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
+  const accept = jest.fn();
+  // The rejection is sent, then the socket call throws (connection closing)
+  const reject = jest.fn(() => { throw new Error('socket closed'); });
+  const reportsAProblem = { validate: async (directory: any, reporter: any) => { reporter.addFolder(directory.path, 'nfo_missing', 'NFO possibly missing', 0); } };
+  const context: any = {
+    api: { postEvent: async () => undefined },
+    logger: { info: () => undefined, verbose: () => undefined, error: () => undefined },
+    configGetter: () => ({ validators: [reportsAProblem], ignoreExcluded: false, separateLogFile: false }),
+    isPathAccepted: () => false,
+  };
+  await ScanRunners(context).onBundleFinished({ type: { id: 'directory' }, target: dir, name: 'x' } as any, accept, reject);
+  expect(reject).toHaveBeenCalledTimes(1);
+  expect(accept).not.toHaveBeenCalled();
+});
