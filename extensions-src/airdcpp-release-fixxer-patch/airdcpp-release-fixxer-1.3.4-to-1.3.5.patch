+import path from 'node:path';
+
+import ScanRunners from '../src/ScanRunners';
+import { tmpDir, write } from './helpers';
+
+const context = (validators: any[], onFileMissing = jest.fn()) => ({
+  api: { postEvent: async () => undefined },
+  logger: { info: () => undefined, verbose: () => undefined, error: () => undefined },
+  configGetter: () => ({ validators, ignoreExcluded: false, separateLogFile: false }),
+  isPathAccepted: () => false,
+  onFileMissing,
+} as any);
+
+const throwing = { validate: async () => { throw new Error('boom'); } };
+
+test('a throwing bundle scan answers at once (accept) instead of leaving the client waiting', async () => {
+  const dir = path.join(tmpDir(), 'Some.Release-GRP');
+  write(path.join(dir, 'a.rar'));
