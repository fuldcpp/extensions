new file mode 100644
index 0000000..7c7312b
--- /dev/null
+++ b/tests/helpers.ts
@@ -0,0 +1,91 @@
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+export const tmpDir = () => fs.mkdtempSync(path.join(os.tmpdir(), 'rfx-'));
+
+export const write = (file: string, content: string | Buffer = 'x') => {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, content);
+  return file;
+};
+
+// A fake API socket for CrcRedownload: records searches, downloads and events; search results
+// come from `results(pattern)`
+export const fakeSocket = (results: (pattern: string) => Array<{ id: string; name: string }> = () => []) => {
+  const searches: string[] = [];
+  const downloads: Array<{ resultId: string; body: any }> = [];
+  const events: Array<{ text: string; severity: string }> = [];
+  const listeners: { [key in string]: (data: any) => any } = {};
+  let lastPattern = '';
+  const socket: any = {
+    post: async (url: string, body: any) => {
+      if (url === 'events') {
+        events.push(body);
+        return;
+      }
+
+      if (url === 'search') {
+        return { id: 's1' };
+      }
+
+      if (url.endsWith('/hub_search')) {
+        lastPattern = body.query.pattern;
+        searches.push(lastPattern);
+        return;
+      }
+
+      const download = /results\/([^/]+)\/download$/.exec(url);
+      if (download) {
+        downloads.push({ resultId: download[1], body });
+        return;
+      }
+
+      throw new Error(`unexpected POST ${url}`);
+    },
+    get: async (url: string) => {
+      if (/\/results\//.test(url)) {
+        return results(lastPattern);
+      }
+
+      throw new Error(`unexpected GET ${url}`);
+    },
+    delete: async () => undefined,
+    addListener: async (module: string, event: string, callback: (data: any) => any) => {
+      listeners[`${module}/${event}`] = callback;
+    },
+  };
+
+  // The client reporting a CRC failure, through the listener the extension registers in start()
+  // (the listener does not await its handler, and the handler does real file I/O)
+  const hasherFileFailed = async (data: { error_id: string; path: string }) => {
+    await listeners['hash/hasher_file_failed'](data);
+    await settle();
+    await new Promise(resolve => setTimeout(resolve, 100));
+    await settle();
+  };
+
+  return { socket, searches, downloads, events, hasherFileFailed };
+};
+
+export const settings = (overrides: any = {}) => ({
+  getDeleteFiles: () => true,
+  getRedownload: () => true,
+  getSearchWaitSeconds: () => 0,
+  getOverflowBackoffSeconds: () => 0,
+  getRetryIntervalMinutes: () => 60,
+  getRetryMaxHours: () => 0,
+  ...overrides,
+});
+
+// Lets queued async work (the serialized search queue) run to completion, including timers of
+// 0 ms and real file I/O in between
+export const settle = async () => {
+  for (let round = 0; round < 3; round++) {
+    for (let i = 0; i < 50; i++) {
+      await new Promise(resolve => setImmediate(resolve));
+    }
+
+    await new Promise(resolve => setTimeout(resolve, 30));
+  }
+};
